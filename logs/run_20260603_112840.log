[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m ### 1. 翻译题干
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m Aya 每天走 9 公里，然后去咖啡店。当她以恒定速度 $s$ 公里/小时行走时，走路需要 4 小时，包括 $t$ 分钟在咖啡店的时间。当她以 $s+2$ 公里/小时的速度行走时，走路需要 2 小时 24 分钟，包括 $t$ 分钟在咖啡店的时间。假设 Aya 以 $s+\frac{1}{2}$ 公里/小时的速度行走。求她走路时，包括 $t$ 分钟在咖啡店的时间，一共需要多少分钟。
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m ---
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m ### 2. 设变量
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m - 走路距离：$d = 9$ 公里
[36m(TaskRunner pid=1540138)[0m - 走路速度：$s$ 公里/小时
[36m(TaskRunner pid=1540138)[0m - 走路时间：$t$ 分钟
[36m(TaskRunner pid=1540138)[0m - 第一次速度：$s$ 公里/小时，走路时间：$4$ 小时 $= 4 \times 60 = 240$ 分钟
[36m(TaskRunner pid=1540138)[0m - 第二次速度：$s+2$ 公里/小时，走路时间：$2$ 小时 24 分钟 $= 2 \times 60 + 24 = 144$ 分钟
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m ---
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m ### 3. 列方程
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m **第一种情况：**
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m 走路时间：$240$ 分钟，包括 $t$ 分钟在咖啡店，所以走路时间 = $240 - t$ 分钟
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m 走的路程 = 9 公里，速度 = $s$ 公里/小时
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m $$
[36m(TaskRunner pid=1540138)[0m \text{路程} = \text{速度} \times \text{时间} \\
[36m(TaskRunner pid=1540138)[0m 9 = s \times (240 - t)
[36m(TaskRunner pid=1540138)[0m $$
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m 即：
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m $$
[36m(TaskRunner pid=1540138)[0m s(240 - t) = 9 \quad \text{(方程 1)}
[36m(TaskRunner pid=1540138)[0m $$
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m ---
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m **第二种情况：**
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m 走路时间：$144$ 分钟，包括 $t$ 分钟在咖啡店，所以走路时间 = $144 - t$ 分钟
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m 走的路程 = 9 公里，速度 = $s + 2$ 公里/小时
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m $$
[36m(TaskRunner pid=1540138)[0m 9 = (s + 2)(144 - t)
[36m(TaskRunner pid=1540138)[0m $$
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m 即：
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m $$
[36m(TaskRunner pid=1540138)[0m (s + 2)(144 - t) = 9 \quad \text{(方程 2)}
[36m(TaskRunner pid=1540138)[0m $$
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m ---
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m ### 4. 联立方程
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m 我们有：
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m $$
[36m(TaskRunner pid=1540138)[0m s(240 - t) = 9 \quad \text{(1)} \\
[36m(TaskRunner pid=1540138)[0m (s + 2)(144 - t) = 9 \quad \text{(2)}
[36m(TaskRunner pid=1540138)[0m $$
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m 将方程 1 和方程 2 相除：
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m $$
[36m(TaskRunner pid=1540138)[0m \frac{s(240 - t)}{(s + 2)(144 - t)} = 1
[36m(TaskRunner pid=1540138)[0m $$
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m 即：
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m $$
[36m(TaskRunner pid=1540138)[0m s(240 - t) = (s + 2)(144 - t)
[36m(TaskRunner pid=1540138)[0m $$
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m 展开右边：
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m $$
[36m(TaskRunner pid=1540138)[0m s(240 - t) = s \cdot 144 - s \cdot t + 2 \cdot 144 - 2 \cdot t
[36m(TaskRunner pid=1540138)[0m $$
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m 整理：
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m $$
[36m(TaskRunner pid=1540138)[0m 240s - st = 144s - st + 288 - 2t
[36m(TaskRunner pid=1540138)[0m $$
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m 两边消去 $-st$：
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m $$
[36m(TaskRunner pid=1540138)[0m 240s = 144s + 288 - 2t
[36m(TaskRunner pid=1540138)[0m $$
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m 移项：
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m $$
[36m(TaskRunner pid=1540138)[0m 240s - 144s = 288 - 2t \\
[36m(TaskRunner pid=1540138)[0m 96s = 288 - 2t \quad \text{(方程 3)}
[36m(TaskRunner pid=1540138)[0m $$
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m ---
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m ### 5. 求 $s$ 和 $t$
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m 从方程 3：
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m $$
[36m(TaskRunner pid=1540138)[0m 96s = 288 - 2t \\
[36m(TaskRunner pid=1540138)[0m \Rightarrow s = \frac{288 - 2t}{96} = \frac{144 - t}{48}
[36m(TaskRunner pid=1540138)[0m $$
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m 将 $s$ 代入方程 1：
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m $$
[36m(TaskRunner pid=1540138)[0m s(240 - t) = 9 \\
[36m(TaskRunner pid=1540138)[0m \frac{144 - t}{48}(240 - t) = 9
[36m(TaskRunner pid=1540138)[0m $$
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m 乘以 48：
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m $$
[36m(TaskRunner pid=1540138)[0m (144 - t)(240 - t) = 432
[36m(TaskRunner pid=1540138)[0m $$
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m 展开左边：
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m $$
[36m(TaskRunner pid=1540138)[0m 144 \cdot 240 - 144t - 240t + t^2 = 432 \\
[36m(TaskRunner pid=1540138)[0m 34560 - 384t + t^2 = 432
[36m(TaskRunner pid=1540138)[0m $$
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m 移项：
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m $$
[36m(TaskRunner pid=1540138)[0m t^2 - 384t + 34560 - 432 = 0 \\
[36m(TaskRunner pid=1540138)[0m t^2 - 384t + 34128 = 0
[36m(TaskRunner pid=1540138)[0m $$
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m 解这个二次方程：
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m $$
[36m(TaskRunner pid=1540138)[0m t = \frac{384 \pm \sqrt{384^2 - 4 \cdot 1 \cdot 34128}}{2}
[36m(TaskRunner pid=1540138)[0m $$
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m 计算判别式：
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m $$
[36m(TaskRunner pid=1540138)[0m 384^2 = 147456 \\
[36m(TaskRunner pid=1540138)[0m 4 \cdot 34128 = 136512 \\
[36m(TaskRunner pid=1540138)[0m \Delta = 147456 - 136512 = 10944
[36m(TaskRunner pid=1540138)[0m $$
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m $$
[36m(TaskRunner pid=1540138)[0m t = \frac{384 \pm \sqrt{10944}}{2}
[36m(TaskRunner pid=1540138)[0m $$
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m $$
[36m(TaskRunner pid=1540138)[0m \sqrt{10944} = 104.6
[36m(TaskRunner pid=1540138)[0m $$
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m 所以：
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m $$
[36m(TaskRunner pid=1540138)[0m t = \frac{384 \pm 104.6}{2}
[36m(TaskRunner pid=1540138)[0m $$
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m 取正解：
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m $$
[36m(TaskRunner pid=1540138)[0m t = \frac{384 + 104.6}{2} = \frac{488.6}{2} = 244.3 \text{ 分钟}
[36m(TaskRunner pid=1540138)[0m $$
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m 取负解：
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m $$
[36m(TaskRunner pid=1540138)[0m t = \frac{384 - 104.6}{2} = \frac{279.4}{2} = 139.7 \text{ 分钟}
[36m(TaskRunner pid=1540138)[0m $$
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m 由于 $t$ 是时间，应为正数，所以 $t = 139.7$ 分钟。
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m ---
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m ### 6. 求速度 $s$
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m $$
[36m(TaskRunner pid=1540138)[0m s = \frac{144 - t}{48} = \frac{144 - 139.7}{48} = \frac{4.3}{48} = 0.0896 \text{ 公里/分钟}
[36m(TaskRunner pid=1540138)[0m $$
[36m(TaskRunner pid=1540138)[0m 
[36m(TaskRunner pid=1540138)[0m ---
